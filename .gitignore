# Secrets / credentials
*.pem

# Python
venv/
__pycache__/
*.pyc

# Environment variables and logs
**/.env
*.log
backend.log
worker.log
crash.log

# OS generated files
.DS_Store

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.zip

# Local-only notes, never meant to be committed
AWS_NOTES.md

# Real per-run values (RDS endpoint, S3 bucket, credentials) never touch disk
# during a normal deploy - setup.sh embeds them straight into the ArgoCD
# Application it applies. This file only exists for anyone deploying the
# chart manually with `helm upgrade -f`, so it's ignored just in case.
helm/values-dynamic.yaml
!helm/values-dynamic.example.yaml
