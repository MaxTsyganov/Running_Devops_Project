%% Jenkins CI/CD architecture - Assignment 4
%% Groundwork skeleton: structure only, matches the PDF's required-elements
%% list (section 7). Styling/colors and exact resource names still TODO -
%% will be polished the same way the Assignment 3 diagram was.

flowchart TB
    Dev[Developer] -->|push / PR| Git[Git repository]
    Git -->|webhook| CIJob

    subgraph AWS[AWS Account]
        subgraph EKS[EKS Cluster]
            subgraph JenkinsNS["jenkins namespace"]
                Controller[Jenkins controller Pod\nfixed, never runs builds]
                PVC[(PersistentVolumeClaim\nJenkins home)]
                Controller --- PVC
                CIJob[ci-application job]
                CDJob[cd-application job]
                CIAgent["CI agent Pod (ephemeral)\nci-build-sa"]
                CDAgent["CD agent Pod (ephemeral)\ncd-deploy-sa"]
                Controller -.spawns.-> CIAgent
                Controller -.spawns.-> CDAgent
                CIJob --> CIAgent
                CDJob --> CDAgent
            end

            subgraph AppNS["devops-app namespace"]
                Deployments[Deployments: frontend / backend / worker]
                Services[Services]
                Ingress[Ingress / LoadBalancer]
            end

            CDAgent -->|kubectl / helm\nvia cd-deploy-sa RBAC| Deployments
        end

        ECR[(ECR registry)]
        CIAgent -->|push image\nvia IRSA| ECR
        CDAgent -.reads tag/digest.-> ECR
    end

    User[End user] --> Ingress
    Ingress --> Services --> Deployments

