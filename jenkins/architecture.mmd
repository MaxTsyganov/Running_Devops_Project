%% Jenkins CI/CD + Observability architecture - Assignments 4-5 - Deployment View
%% Shows where everything actually runs: clusters, namespaces, Pods,
%% Services, storage, and network boundaries. For the logical order of a
%% single pipeline run (commit -> CI -> build -> registry -> CD -> rollout
%% -> smoke test -> rollback), see pipeline-flow.mmd instead - cramming both
%% views into one diagram made it unreadable.

flowchart TB
    Dev[Developer]
    User[End user]
    GH[GitHub repository]
    Smee[["smee.io channel\n(public relay, outbound-only from our side)"]]
    Slack[["Slack (bonus)\nIncoming Webhook"]]
    ConfigRepo[["Same repo, config path:\njenkins/values.yaml (JCasC + plugin list)\njenkins/jobs/*.xml (job definitions)"]]

    Dev -->|push or PR| GH
    GH -->|webhook POST\nHTTPS, HMAC-signed| Smee
    User -->|HTTPS| ALB

    subgraph AWSAcct["AWS Account"]
        direction TB

        subgraph VPC["VPC"]
            direction TB

            subgraph PubSubnet["Public subnet(s)"]
                ALB[/"frontend-service\n(LoadBalancer)"/]
            end

            subgraph PrivSubnet["Private subnet(s)"]
                direction TB

                subgraph EKS["EKS Cluster - devops-cluster"]
                    direction TB

                    subgraph JenkinsNS["namespace: jenkins"]
                        direction TB
                        Relay["webhook-relay Pod\n(custom SSE relay, outbound only -\nJenkins itself has no inbound\nport, Ingress, or public IP)"]
                        Controller["Jenkins controller Pod\n(StatefulSet, 1 replica, fixed -\nnever runs builds itself)"]
                        PVC[("PVC: Jenkins home\nebs-gp3")]
                        JSvc[["Service: jenkins\n(ClusterIP only)"]]
                        Controller --- PVC
                        Controller --- JSvc
                        CIAgent["CI agent Pod(s) (ephemeral)\npython + kaniko + trivy containers\nSA: ci-build-sa\none Pod per matrix cell -\nup to 3 running in parallel"]
                        CDAgent["CD agent Pod (ephemeral)\nkubectl+helm container\nSA: cd-deploy-sa"]
                        PRAgent["PR agent Pod (ephemeral, bonus)\nsame containers as ci-agent\nSA: ci-build-sa, never pushes to ECR"]
                        Controller -.spawns, deletes after build.-> CIAgent
                        Controller -.spawns, deletes after build.-> CDAgent
                        Controller -.spawns, deletes after build.-> PRAgent
                        NetPol{{"NetworkPolicy: default-deny +\nper-workload allow (jenkins/networkpolicies.yaml)"}}
                    end

                    subgraph AppNS["namespace: devops-app"]
                        direction TB
                        FE["frontend-deployment\n(2 replicas)\nnginx + nginx-prometheus-exporter\nsidecar (Assignment 5) - scrapes\nnginx's own stub_status on :8081,\nre-exposes on :9113"]
                        BE["backend-deployment\n(2 replicas)\nSA: backend-sa"]
                        WK["worker-deployment\n(1 replica)\nSA: worker-sa"]
                        BESvc[["backend-service\n(ClusterIP)"]]
                    end

                    subgraph ESONS["namespace: external-secrets"]
                        ESO["External Secrets Operator\nSA: external-secrets-sa"]
                    end

                    subgraph ObsNS["namespace: observability (Assignment 5)"]
                        direction TB
                        Prom[("Prometheus\nPVC: ebs-gp3, 5Gi, 7d retention")]
                        Graf["Grafana\nno PVC - dashboards from Git\n(sidecar-ConfigMap)"]
                        AM["Alertmanager"]
                        ObsNetPol{{"NetworkPolicy: default-deny +\nper-workload allow\n(observability/networkpolicies.yaml)"}}
                    end

                    RDS[("RDS PostgreSQL")]
                end
            end
        end

        subgraph AWSMgd["AWS managed services (regional, outside the VPC)"]
            direction LR
            ECR[("ECR\ndevops-frontend / -backend / -worker")]
            S3[("S3 bucket")]
            SNS(["SNS topic"])
            SecMgr[("Secrets Manager\nRDS password")]
            KMS[("KMS\nasymmetric signing key\nalias/devops-app-cosign")]
        end
    end

    Smee -->|forwarded, routed by\nevent type| Relay
    Relay -->|POST /github-webhook/\ninternal, ClusterIP only| JSvc
    Relay -->|POST /generic-webhook-trigger/\npull_request events only, bonus| JSvc
    JSvc --> Controller
    Controller -.triggers on push.-> CIAgent
    Controller -.triggers on pull_request.-> PRAgent

    CIAgent -->|docker push\nvia ci-build-sa IRSA| ECR
    CIAgent -->|cosign sign --key awskms://\nvia ci-build-sa IRSA| KMS
    CIAgent -.notifySlack, bonus.-> Slack
    CDAgent -->|kubectl / helm\nvia cd-deploy-sa RBAC\nRole+RoleBinding, devops-app only| FE
    CDAgent --> BE
    CDAgent --> WK
    CDAgent -.reads image tag/digest.-> ECR
    CDAgent -.notifySlack, bonus.-> Slack

    ALB --> FE
    FE -->|reverse proxy| BESvc --> BE
    BE -->|reads/writes\nvia backend-sa IRSA| RDS
    BE -->|uploads\nvia backend-sa IRSA| S3
    BE -->|publishes\nvia backend-sa IRSA| SNS
    WK -->|polls\nvia worker-sa IRSA| RDS
    WK -->|publishes\nvia worker-sa IRSA| SNS
    ESO -->|reads password\nvia external-secrets-sa IRSA| SecMgr
    ESO -.writes app-secrets Secret.-> BE
    ESO -.writes app-secrets Secret.-> WK

    Admin["Admin (developer machine)"] -.->|kubectl port-forward\nnever public| JSvc
    Admin -.->|helm install/upgrade -f values.yaml\napplies JCasC (clouds, agent templates,\nShared Library) + installPlugins, from Git| Controller
    Admin -.->|create-jobs.sh\nREST API, idempotent, config.xml from Git\nnever hand-typed in the Jenkins UI| Controller
    ConfigRepo -.source for both calls above.-> Admin

    Prom -->|scrapes /prometheus\nvia ServiceMonitor| JSvc
    Prom -->|scrapes /metrics x3\nvia ServiceMonitor| FE
    Prom -.-> BE
    Prom -.-> WK
    Prom -->|alerts| AM
    AM -.->|notifies, Slack receiver| Slack
    Graf -->|queries| Prom
    Graf -.->|queries| AM
    CDAgent -->|Monitoring Gate:\nup==1 + error-rate query| Prom
    Admin -.->|kubectl port-forward\nnever public| Graf

    classDef external fill:#eee,stroke:#999,color:#333
    classDef aws fill:#fff3e0,stroke:#e65100,color:#333
    classDef jenkins fill:#e3f2fd,stroke:#1565c0,color:#333
    classDef app fill:#e8f5e9,stroke:#2e7d32,color:#333
    classDef data fill:#fce4ec,stroke:#ad1457,color:#333
    classDef obs fill:#fdece7,stroke:#c0392b,color:#333
    class Dev,User,GH,Smee,Admin,Slack,ConfigRepo external
    class ALB,RDS,ECR,S3,SNS,SecMgr,KMS aws
    class Relay,Controller,PVC,JSvc,CIAgent,CDAgent,PRAgent jenkins
    class FE,BE,WK,BESvc,ESO app
    class Prom,Graf,AM obs
