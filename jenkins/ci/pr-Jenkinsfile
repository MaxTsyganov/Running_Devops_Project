// PR quality-gate pipeline: lint, test, build (no push), scan. Never pushes to
// ECR or triggers cd-application. Triggered by GitHub pull_request events via
// the generic-webhook-trigger plugin, since the "github" plugin's push trigger
// (used by ci/Jenkinsfile) only fires on push - see ci-application-pr-config.xml
// for the trigger and jenkins/webhook-relay.yaml for the event routing.
@Library('devops-shared-lib') _
pipeline {
    agent {
        kubernetes {
            cloud 'devops-agents'
            inheritFrom 'ci-agent'
        }
    }

    environment {
        REPO_URL = 'https://github.com/MaxTsyganov/Running_Devops_Project.git'
    }

    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
    }

    stages {
        stage('Checkout PR head') {
            steps {
                script {
                    if (!env.PR_HEAD_SHA || !env.PR_NUMBER) {
                        error("PR_HEAD_SHA/PR_NUMBER missing - this job only runs from the pull_request webhook trigger (generic-webhook-trigger), never a manual Build Now.")
                    }
                }
                // Explicit refspec into GitHub's PR ref namespace, rather than trusting
                // the default branch at checkout time - only the PR's actual head commit
                // should be evaluated.
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "${env.PR_HEAD_SHA}"]],
                    userRemoteConfigs: [[
                        url: "${REPO_URL}",
                        refspec: '+refs/pull/*/head:refs/remotes/origin/pr/*'
                    ]]
                ])
                echo "PR:   #${env.PR_NUMBER} (${env.PR_HEAD_REF ?: 'unknown branch'})"
                echo "Head: ${env.PR_HEAD_SHA}"
            }
        }

        stage('Validation') {
            steps {
                sh '''
                    set -e
                    for svc in frontend backend worker; do
                        test -f "$svc/Dockerfile" || { echo "Missing $svc/Dockerfile"; exit 1; }
                        test -f "$svc/.dockerignore" || { echo "Missing $svc/.dockerignore"; exit 1; }
                    done
                '''
            }
        }

        stage('Static Analysis / Lint') {
            steps {
                container('python') {
                    lintCode()
                }
            }
        }

        stage('Tests') {
            steps {
                container('python') {
                    runTests()
                }
            }
            post {
                always {
                    junit 'backend/test-results.xml'
                }
            }
        }

        // Sequential, not a matrix: this is a quality gate, not the deploy-bound
        // pipeline - parallel builds are already proven in ci/Jenkinsfile, so this
        // avoids duplicating that matrix machinery for a pipeline that never
        // produces anything deployable.
        stage('Build (no push) + Scan') {
            steps {
                container('kaniko') {
                    sh '''
                        set -e
                        for svc in frontend backend worker; do
                            echo "Building devops-$svc (PR #${PR_NUMBER}, quality gate only - never pushed to ECR) ..."
                            /kaniko/executor \
                                --context "dir://$(pwd)/$svc" \
                                --dockerfile "$svc/Dockerfile" \
                                --no-push \
                                --tarPath "$(pwd)/$svc.tar" \
                                --cache=false
                        done
                    '''
                }
                container('trivy') {
                    script {
                        // Same blocking scan the real pipeline uses (jenkins/shared-library/
                        // vars/trivyScan.groovy) - a fixable CRITICAL finding fails a PR the
                        // same way it fails a push to main. No SBOM/Cosign: both only matter
                        // for an image that's actually deployed, which this one never is.
                        for (svc in ['frontend', 'backend', 'worker']) {
                            trivyScan("${env.WORKSPACE}/${svc}.tar", true, svc)
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
