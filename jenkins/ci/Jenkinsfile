// CI pipeline: build, test, scan, push, sign. Never deploys - that's
// jenkins/cd/Jenkinsfile's job. Checkout/Lint/Test run on the "ci-agent" pod
// template (jenkins/values.yaml); Build/Scan/Push+Sign run per service in a
// matrix, each on its own freshly-provisioned pod for genuine parallelism.
// No Docker socket is ever mounted - Kaniko builds to a local tarball, and
// nothing reaches ECR until Trivy scans it (crane pushes after the scan passes).
@Library('devops-shared-lib') _
pipeline {
    agent {
        kubernetes {
            // inheritFrom, not label: "label" alone creates a bare inline template with
            // no containers, not ci-agent's python/kaniko/trivy setup (jenkins/values.yaml).
            // cloud is explicit too: two clouds are registered, and without naming one,
            // ci-agent wasn't resolving.
            cloud 'devops-agents'
            inheritFrom 'ci-agent'
        }
    }

    environment {
        // Non-secret: registry hostname and repo names, not credentials. ECR auth
        // goes through ci-build-sa's IRSA role automatically via Kaniko's ECR
        // credential helper - no explicit credential ever appears in this file.
        ECR_REGISTRY = '957905603240.dkr.ecr.us-east-1.amazonaws.com'
        // Pinned release. Cosign's official image is distroless (no shell), so the
        // static binary is fetched at runtime into the existing "python" container
        // instead of adding a fourth agent container.
        COSIGN_VERSION = 'v3.1.3'
        // sha256 of cosign-linux-amd64 from that release's own cosign_checksums.txt -
        // hardcoded so a compromised release download can't also serve a fake checksum.
        // Bumping COSIGN_VERSION means updating this too.
        COSIGN_SHA256 = '4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71'
        // crane (go-containerregistry) pushes the already-scanned tarball to ECR
        // without rebuilding - see Push + Sign below. Same distroless/fetch-a-binary
        // reasoning as Cosign.
        CRANE_VERSION = 'v0.21.9'
        // sha256 of go-containerregistry_Linux_x86_64.tar.gz from that release's
        // checksums.txt, hardcoded for the same reason as COSIGN_SHA256 above.
        CRANE_SHA256 = '5c16d8ddb971cb1d5e6ed8b1e743da8224414eeba2c2762d8f1a61b2f095699e'
        // Signs with an asymmetric KMS key (terraform/kms.tf) - no private key
        // material exists anywhere, matching this project's IRSA-everywhere pattern.
        COSIGN_KMS_KEY = 'awskms:///alias/devops-app-cosign'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    // Full 40-char SHA, not truncated: ECR tags allow up to 128 chars and
                    // this is never used as a Kubernetes label (capped at 63), so a shorter
                    // tag would only add collision risk for no benefit.
                    env.GIT_COMMIT_SHA = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG = env.GIT_COMMIT_SHA
                }
                echo "Branch:       ${env.GIT_BRANCH ?: env.BRANCH_NAME}"
                echo "Commit:       ${env.GIT_COMMIT_SHA}"
                echo "Build number: ${env.BUILD_NUMBER}"
                echo "Image tag:    ${env.IMAGE_TAG}"
            }
        }

        stage('Validation') {
            steps {
                sh '''
                    set -e
                    for svc in frontend backend worker; do
                        test -f "$svc/Dockerfile" || { echo "Missing $svc/Dockerfile"; exit 1; }
                        test -f "$svc/.dockerignore" || { echo "Missing $svc/.dockerignore"; exit 1; }
                    done
                    test -f helm/devops-app/Chart.yaml || { echo "Missing Helm chart"; exit 1; }
                    test -f helm/devops-app/values.yaml || { echo "Missing chart values.yaml"; exit 1; }
                '''
            }
        }

        // Assignment 5 - only in ci-application, not pr-Jenkinsfile: validates
        // observability/ and the ServiceMonitor template, which a PR gate has no
        // reason to check before merge. Kept inline, not in shared-library/, since
        // it's only ever called from this one pipeline.
        stage('Observability Validation') {
            steps {
                container('python') {
                    sh '''
                        set -e

                        echo "--- Dashboard JSON syntax ---"
                        for f in observability/dashboards/*.json; do
                            python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$f"
                        done

                        echo "--- Fetching promtool, kubeconform, helm (checksum-verified static binaries) ---"
                        # Same pattern as Cosign/crane above: pinned version, hardcoded
                        # checksum from the release's own checksums file. urllib, not curl -
                        # this container has neither curl nor wget.
                        python3 -c "import urllib.request; urllib.request.urlretrieve('https://github.com/prometheus/prometheus/releases/download/v3.14.0/prometheus-3.14.0.linux-amd64.tar.gz', '/tmp/prometheus.tar.gz')"
                        echo "f665c6da19eb7ba399c915d30c7d9793c9b417bf8a749b504bc470678631478d  /tmp/prometheus.tar.gz" | sha256sum -c -
                        tar -xzf /tmp/prometheus.tar.gz -C /tmp

                        python3 -c "import urllib.request; urllib.request.urlretrieve('https://github.com/yannh/kubeconform/releases/download/v0.8.0/kubeconform-linux-amd64.tar.gz', '/tmp/kubeconform.tar.gz')"
                        echo "9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883  /tmp/kubeconform.tar.gz" | sha256sum -c -
                        tar -xzf /tmp/kubeconform.tar.gz -C /tmp

                        # v3.16, matching cd-agent's dtzar/helm-kubectl:3.16 image
                        # (jenkins/values.yaml) - only used here to render the ServiceMonitor
                        # template before schema-checking it.
                        python3 -c "import urllib.request; urllib.request.urlretrieve('https://get.helm.sh/helm-v3.16.4-linux-amd64.tar.gz', '/tmp/helm.tar.gz')"
                        echo "fc307327959aa38ed8f9f7e66d45492bb022a66c3e5da6063958254b9767d179  /tmp/helm.tar.gz" | sha256sum -c -
                        tar -xzf /tmp/helm.tar.gz -C /tmp

                        echo "--- PrometheusRule semantics (promtool) ---"
                        pip install --quiet --no-cache-dir pyyaml==6.0.2
                        mkdir -p /tmp/rules-extracted
                        # promtool's native schema is a bare {groups: [...]}, but a
                        # PrometheusRule CRD wraps that under apiVersion/kind/metadata/
                        # spec.groups. Pulls just the groups key so this stays correct even
                        # if spec gains other fields.
                        python3 -c "
import yaml, glob, os
for f in glob.glob('observability/rules/*.yaml'):
    with open(f) as fh:
        doc = yaml.safe_load(fh)
    out = {'groups': doc['spec']['groups']}
    with open(os.path.join('/tmp/rules-extracted', os.path.basename(f)), 'w') as fh:
        yaml.safe_dump(out, fh)
"
                        /tmp/prometheus-3.14.0.linux-amd64/promtool check rules /tmp/rules-extracted/*.yaml

                        echo "--- ServiceMonitor/PrometheusRule/NetworkPolicy schema (kubeconform) ---"
                        # Real CRD schema validation, not just "is this valid YAML" - catches
                        # structurally wrong fields before they'd surface as a confusing
                        # kubectl apply failure. datreeio/CRDs-catalog covers third-party CRDs
                        # (prometheus-operator included) that kubeconform's bundled set doesn't.
                        /tmp/linux-amd64/helm template devops-app ./helm/devops-app \
                            --namespace devops-app \
                            --set image.registry=validate --set image.tag=validate \
                            --set config.dbHost=validate --set config.s3BucketName=validate \
                            --set config.snsTopicArn=validate --set secrets.dbPasswordSecretName=validate \
                            -s templates/servicemonitors.yaml > /tmp/rendered-servicemonitors.yaml
                        /tmp/kubeconform -strict -summary \
                            -schema-location default \
                            -schema-location 'https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json' \
                            /tmp/rendered-servicemonitors.yaml \
                            jenkins/servicemonitor.yaml \
                            observability/rules/*.yaml \
                            observability/networkpolicies.yaml
                    '''
                }
            }
        }

        stage('Static Analysis / Lint') {
            steps {
                container('python') {
                    lintCode()
                }
            }
        }

        stage('Tests') {
            steps {
                container('python') {
                    runTests()
                }
            }
            post {
                always {
                    junit 'backend/test-results.xml'
                }
            }
        }

        // One matrix cell per service, each on its own ci-agent pod (the "agent"
        // below overrides the top-level agent for just this stage) - true parallel
        // builds. Each cell has its own checkout since separate pods share no
        // filesystem; IMAGE_TAG still comes from the Checkout stage above so all
        // three land on the same immutable tag.
        stage('Build, Scan, Push+Sign') {
            matrix {
                axes {
                    axis {
                        name 'SERVICE'
                        values 'frontend', 'backend', 'worker'
                    }
                }
                agent {
                    kubernetes {
                        cloud 'devops-agents'
                        inheritFrom 'ci-agent'
                    }
                }
                stages {
                    stage('Checkout') {
                        steps {
                            checkout scm
                        }
                    }

                    stage('Build') {
                        steps {
                            container('kaniko') {
                                sh '''
                                    set -e
                                    echo "Building devops-${SERVICE}:${IMAGE_TAG} (local tarball, not pushed yet)..."
                                    # $(pwd)/${SERVICE}.tar, not /workspace/...: /workspace is
                                    # Kaniko's own private scratch dir, not the Pod's shared
                                    # workspace volume - Sign previously couldn't find a file
                                    # written to a path that was never actually shared.
                                    # --no-push --tarPath, not a direct --destination push: the
                                    # image is scanned from this tarball before anything reaches
                                    # ECR. --destination is still required so the tarball's
                                    # manifest is tagged correctly for crane to push later.
                                    # No --digest-file: Kaniko's predicted digest does NOT match
                                    # what crane actually pushes (different manifest
                                    # serialization despite identical content) - Cosign signing
                                    # that digest 404'd. Push + Sign instead captures crane's own
                                    # reported digest, the value guaranteed to match the registry.
                                    /kaniko/executor \
                                        --context "dir://$(pwd)/${SERVICE}" \
                                        --dockerfile "${SERVICE}/Dockerfile" \
                                        --destination "${ECR_REGISTRY}/devops-${SERVICE}:${IMAGE_TAG}" \
                                        --no-push \
                                        --tarPath "$(pwd)/${SERVICE}.tar" \
                                        --cache=false
                                '''
                            }
                        }
                    }

                    stage('Scan + SBOM') {
                        steps {
                            container('trivy') {
                                // Scans the local tarball Build produced, not a pushed image - Kaniko
                                // no longer pushes before this gate runs. Scan logic lives in the
                                // Shared Library (jenkins/shared-library/vars/trivyScan.groovy), the
                                // same tarball-scanning mode pr-Jenkinsfile's quality gate uses. SBOM
                                // generation stays CI-only - only meaningful for an image that's
                                // actually going to be deployed.
                                trivyScan("${env.WORKSPACE}/${SERVICE}.tar", true, "${SERVICE}")
                                sh '''
                                    set -e
                                    echo "=== SBOM for devops-${SERVICE}:${IMAGE_TAG} ==="
                                    trivy image --input "${SERVICE}.tar" --format cyclonedx --output "sbom-${SERVICE}.json"
                                '''
                                archiveArtifacts artifacts: "sbom-${SERVICE}.json", fingerprint: true
                            }
                        }
                    }

                    // Combined into one stage: crane's push and cosign's sign need the
                    // same ECR bearer token, and each `sh` step is its own shell -
                    // splitting them would mean fetching the token twice.
                    stage('Push + Sign') {
                        steps {
                            container('python') {
                                sh '''
                                    set -e
                                    # crane pushes the already-scanned tarball straight to ECR without
                                    # rebuilding - the point of building to a tarball first is that a
                                    # failed scan means nothing ever reaches ECR. No official
                                    # go-containerregistry image has a shell, so same
                                    # fetch-a-static-binary approach as Cosign below.
                                    python3 -c "import urllib.request; urllib.request.urlretrieve('https://github.com/google/go-containerregistry/releases/download/${CRANE_VERSION}/go-containerregistry_Linux_x86_64.tar.gz', '/tmp/crane.tar.gz')"
                                    echo "${CRANE_SHA256}  /tmp/crane.tar.gz" | sha256sum -c -
                                    tar -xzf /tmp/crane.tar.gz -C /tmp crane
                                    chmod +x /tmp/crane

                                    # No official Cosign image has a shell - fetch the static binary
                                    # with urllib since this container has neither curl nor wget.
                                    python3 -c "import urllib.request; urllib.request.urlretrieve('https://github.com/sigstore/cosign/releases/download/${COSIGN_VERSION}/cosign-linux-amd64', '/tmp/cosign')"
                                    # Verify against the checksums pinned above before trusting either
                                    # binary - both are fetched over plain HTTPS with no other check in front.
                                    echo "${COSIGN_SHA256}  /tmp/cosign" | sha256sum -c -
                                    chmod +x /tmp/cosign

                                    # set +x from here on: Jenkins' sh step echoes every command (the
                                    # "+ ..." console lines) - without this, the ECR_TOKEN assignment
                                    # and cosign's --registry-password would print the real bearer
                                    # token. Same "never printed to a log" bar as the Slack webhook URL
                                    # and DB password elsewhere in this project.
                                    set +x
                                    # One ECR token for both crane's push and cosign's sign -
                                    # go-containerregistry has no built-in ECR credential helper. boto3,
                                    # not awscli, to avoid a heavier install for one API call - same
                                    # version already pinned in backend/requirements.txt.
                                    pip install --quiet --no-cache-dir boto3==1.34.131
                                    ECR_TOKEN="$(python3 -c "
import base64, boto3
token = boto3.client('ecr', region_name='us-east-1').get_authorization_token()['authorizationData'][0]['authorizationToken']
print(base64.b64decode(token).decode().split(':', 1)[1])
")"
                                    /tmp/crane auth login "${ECR_REGISTRY}" -u AWS -p "$ECR_TOKEN"
                                    set -x

                                    echo "Pushing devops-${SERVICE}:${IMAGE_TAG} (already scanned)..."
                                    # Captures crane's reported digest from stdout (crane's own diagnostics
                                    # go to stderr) - this is the digest actually stored in ECR by the tool
                                    # that did the pushing, not Kaniko's prediction (see Build stage comment
                                    # on why those can differ).
                                    IMAGE_REF="$(/tmp/crane push "${SERVICE}.tar" "${ECR_REGISTRY}/devops-${SERVICE}:${IMAGE_TAG}")"
                                    DIGEST="${IMAGE_REF#*@}"
                                    echo "$DIGEST" > digest.txt

                                    set +x
                                    echo "Signing $IMAGE_REF with ${COSIGN_KMS_KEY}..."
                                    # Signs by digest, not mutable tag - the digest crane just reported
                                    # pushing. --use-signing-config=false --tlog-upload=false: cosign
                                    # uploads to the public Rekor log by default even for KMS signing
                                    # unless told not to (v3.1.3 ignores a bare --tlog-upload=false under
                                    # its newer signing-config mode; --use-signing-config=false is needed
                                    # to make that flag take effect). That upload would reintroduce the
                                    # public-Sigstore dependency KMS signing was chosen to avoid (see
                                    # README trade-offs).
                                    /tmp/cosign sign --key "${COSIGN_KMS_KEY}" \
                                        --use-signing-config=false --tlog-upload=false \
                                        --registry-username AWS --registry-password "$ECR_TOKEN" \
                                        --yes "$IMAGE_REF"
                                '''
                            }
                        }
                    }

                    stage('Publish Metadata') {
                        steps {
                            sh '''
                                {
                                    echo "SERVICE=${SERVICE}"
                                    echo "IMAGE_TAG=${IMAGE_TAG}"
                                    echo "DIGEST=$(cat digest.txt)"
                                    echo "SIGNED=true"
                                } > "image-metadata-${SERVICE}.txt"
                                cat "image-metadata-${SERVICE}.txt"
                            '''
                            archiveArtifacts artifacts: "image-metadata-${SERVICE}.txt", fingerprint: true
                            // Bubbled into the Pipeline-global env, not just this matrix cell's
                            // Pod - env is shared across the whole run, so post{success{}} below
                            // can read every service's digest to build CD's release manifest. A
                            // local shell variable wouldn't survive past this cell.
                            script {
                                env."DIGEST_${SERVICE}" = sh(script: 'cat digest.txt', returnStdout: true).trim()
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        // Cleans up the workspace (and any transient credentials the
        // Kubernetes plugin injected for this build) whether the build
        // passed or failed.
        always {
            cleanWs()
        }
        success {
            script {
                // Plain KEY=value lines, not JSON: CD parses this with grep/cut in a shell
                // step (jenkins/cd/Jenkinsfile's Input Validation stage), avoiding any
                // JSON library/script-approval surface.
                def manifest = """IMAGE_TAG=${env.IMAGE_TAG}
CI_BUILD_NUMBER=${env.BUILD_NUMBER}
GIT_COMMIT=${env.GIT_COMMIT_SHA}
DIGEST_FRONTEND=${env.DIGEST_frontend}
DIGEST_BACKEND=${env.DIGEST_backend}
DIGEST_WORKER=${env.DIGEST_worker}
"""
                writeFile file: 'release-manifest.txt', text: manifest
                archiveArtifacts artifacts: 'release-manifest.txt', fingerprint: true
                echo "CI succeeded - triggering cd-application with IMAGE_TAG=${env.IMAGE_TAG}"
                build job: 'cd-application',
                      parameters: [
                          string(name: 'IMAGE_TAG', value: env.IMAGE_TAG),
                          text(name: 'RELEASE_MANIFEST', value: manifest)
                      ],
                      wait: false
            }
            container('python') {
                notifySlack('SUCCESS', "Built, scanned, and signed :${env.IMAGE_TAG} for all three services - triggering cd-application.")
            }
        }
        failure {
            container('python') {
                // Not "nothing was built": Kaniko pushes to ECR before Scan/Sign run, and
                // other matrix cells run in parallel and may have already finished. A
                // failure here can leave images in ECR unscanned/unsigned. What's actually
                // guaranteed is that nothing was deployed - cd-application only triggers
                // from post{success{}}.
                notifySlack('FAILURE', "CI failed on commit ${env.GIT_COMMIT_SHA ?: env.GIT_COMMIT} - one or more services may be partially built/pushed; nothing was deployed.")
            }
        }
    }
}
