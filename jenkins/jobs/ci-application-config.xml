<?xml version='1.1' encoding='UTF-8'?>
<flow-definition plugin="workflow-job">
  <description>CI: lint, test, build, tag, push. Never deploys - see jenkins/ci/Jenkinsfile.</description>
  <keepDependencies>false</keepDependencies>
  <properties/>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <url>https://github.com/MaxTsyganov/Running_Devops_Project.git</url>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/main</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <scriptPath>jenkins/ci/Jenkinsfile</scriptPath>
    <lightweight>true</lightweight>
  </definition>
  <!-- Registers the actual GitHub push trigger. githubPush() inside the
       Jenkinsfile alone is not enough - Jenkins only picks that up as a live
       trigger starting from a build that already had it wired here, so it
       has to be declared in the job config itself, not just the pipeline
       script. No "plugin=" version pin, matching jenkins/values.yaml's
       policy of not hand-pinning individual plugin versions. -->
  <triggers>
    <com.cloudbees.jenkins.GitHubPushTrigger>
      <spec></spec>
    </com.cloudbees.jenkins.GitHubPushTrigger>
  </triggers>
  <disabled>false</disabled>
</flow-definition>
