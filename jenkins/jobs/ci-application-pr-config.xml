<?xml version='1.1' encoding='UTF-8'?>
<!-- PR quality gate - see jenkins/ci/pr-Jenkinsfile. Verified live against a
     real controller and a real pull_request webhook delivery. The event-type
     check originally lived here too, extracting the X-GitHub-Event header
     and filtering on it alongside PR_ACTION - but that never worked live
     (Jenkins returned 200, queue stayed empty) because genericHeaderVariables'
     <key> does a literal match against the header name and the plugin's
     $-token substitution doesn't reliably resolve a hyphenated variable name
     either way. Root-caused and then removed rather than patched further:
     jenkins/webhook-relay.yaml's relay.js already only ever forwards actual
     pull_request events to this endpoint (push/ping go to /github-webhook/
     instead) - so re-checking the event type here was redundant on top of
     being the broken part. Filtering on PR_ACTION alone is both simpler and
     the thing that's actually needed. -->
<flow-definition plugin="workflow-job">
  <description>PR quality gate: lint, test, build (no push), scan. Never deploys, never pushes to ECR - see jenkins/ci/pr-Jenkinsfile.</description>
  <keepDependencies>false</keepDependencies>
  <properties/>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <url>https://github.com/MaxTsyganov/Running_Devops_Project.git</url>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/main</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <!-- Only used to fetch pr-Jenkinsfile itself (from main, same as the
         other two jobs) - the pipeline's own "Checkout PR head" stage does
         a second, separate checkout of the PR's actual head commit. -->
    <scriptPath>jenkins/ci/pr-Jenkinsfile</scriptPath>
    <lightweight>true</lightweight>
  </definition>
  <!-- Extracts PR_NUMBER/PR_HEAD_SHA/PR_HEAD_REF/PR_ACTION from the
       incoming JSON straight into environment variables the pipeline reads
       via env.PR_NUMBER etc - no separate ParametersDefinitionProperty
       needed, this plugin binds extracted values directly. regexpFilter*
       only lets opened/synchronize/reopened through; GitHub sends other
       pull_request actions too (closed, labeled, ...) that shouldn't
       trigger a build. No event-type check needed here - this endpoint
       only ever receives pull_request events in the first place (see
       jenkins/webhook-relay.yaml). -->
  <triggers>
    <org.jenkinsci.plugins.gwt.GenericTrigger>
      <spec></spec>
      <genericVariables>
        <org.jenkinsci.plugins.gwt.GenericVariable>
          <expressionType>JSONPath</expressionType>
          <key>PR_NUMBER</key>
          <value>$.number</value>
          <regexpFilter></regexpFilter>
          <defaultValue></defaultValue>
        </org.jenkinsci.plugins.gwt.GenericVariable>
        <org.jenkinsci.plugins.gwt.GenericVariable>
          <expressionType>JSONPath</expressionType>
          <key>PR_HEAD_SHA</key>
          <value>$.pull_request.head.sha</value>
          <regexpFilter></regexpFilter>
          <defaultValue></defaultValue>
        </org.jenkinsci.plugins.gwt.GenericVariable>
        <org.jenkinsci.plugins.gwt.GenericVariable>
          <expressionType>JSONPath</expressionType>
          <key>PR_HEAD_REF</key>
          <value>$.pull_request.head.ref</value>
          <regexpFilter></regexpFilter>
          <defaultValue></defaultValue>
        </org.jenkinsci.plugins.gwt.GenericVariable>
        <org.jenkinsci.plugins.gwt.GenericVariable>
          <expressionType>JSONPath</expressionType>
          <key>PR_ACTION</key>
          <value>$.action</value>
          <regexpFilter></regexpFilter>
          <defaultValue></defaultValue>
        </org.jenkinsci.plugins.gwt.GenericVariable>
      </genericVariables>
      <token>pr-quality-gate</token>
      <printContributedVariables>true</printContributedVariables>
      <printPostContent>false</printPostContent>
      <silentResponse>false</silentResponse>
      <regexpFilterText>$PR_ACTION</regexpFilterText>
      <regexpFilterExpression>^(opened|synchronize|reopened)$</regexpFilterExpression>
      <causeString>Triggered by GitHub pull_request ($PR_ACTION) on PR #$PR_NUMBER</causeString>
    </org.jenkinsci.plugins.gwt.GenericTrigger>
  </triggers>
  <disabled>false</disabled>
</flow-definition>
