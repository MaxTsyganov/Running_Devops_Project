<?xml version='1.1' encoding='UTF-8'?>
<!-- PR quality gate - see jenkins/ci/pr-Jenkinsfile. An earlier version also
     checked the X-GitHub-Event header here, but genericHeaderVariables' <key>
     doesn't reliably resolve a hyphenated header name - removed since
     jenkins/webhook-relay.yaml's relay.js already only forwards pull_request
     events to this endpoint, making that check redundant anyway. Filtering on
     PR_ACTION alone is what's actually needed. -->
<flow-definition plugin="workflow-job">
  <description>PR quality gate: lint, test, build (no push), scan. Never deploys, never pushes to ECR - see jenkins/ci/pr-Jenkinsfile.</description>
  <keepDependencies>false</keepDependencies>
  <properties/>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <url>https://github.com/MaxTsyganov/Running_Devops_Project.git</url>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/main</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <!-- Only used to fetch pr-Jenkinsfile itself (from main) - the pipeline's own
         "Checkout PR head" stage does a second checkout of the PR's actual head. -->
    <scriptPath>jenkins/ci/pr-Jenkinsfile</scriptPath>
    <lightweight>true</lightweight>
  </definition>
  <!-- Extracts PR_NUMBER/PR_HEAD_SHA/PR_HEAD_REF/PR_ACTION from the incoming JSON
       directly into env vars the pipeline reads via env.PR_NUMBER etc. regexpFilter*
       only lets opened/synchronize/reopened through - GitHub sends other
       pull_request actions (closed, labeled, ...) that shouldn't trigger a build. -->
  <triggers>
    <org.jenkinsci.plugins.gwt.GenericTrigger>
      <spec></spec>
      <genericVariables>
        <org.jenkinsci.plugins.gwt.GenericVariable>
          <expressionType>JSONPath</expressionType>
          <key>PR_NUMBER</key>
          <value>$.number</value>
          <regexpFilter></regexpFilter>
          <defaultValue></defaultValue>
        </org.jenkinsci.plugins.gwt.GenericVariable>
        <org.jenkinsci.plugins.gwt.GenericVariable>
          <expressionType>JSONPath</expressionType>
          <key>PR_HEAD_SHA</key>
          <value>$.pull_request.head.sha</value>
          <regexpFilter></regexpFilter>
          <defaultValue></defaultValue>
        </org.jenkinsci.plugins.gwt.GenericVariable>
        <org.jenkinsci.plugins.gwt.GenericVariable>
          <expressionType>JSONPath</expressionType>
          <key>PR_HEAD_REF</key>
          <value>$.pull_request.head.ref</value>
          <regexpFilter></regexpFilter>
          <defaultValue></defaultValue>
        </org.jenkinsci.plugins.gwt.GenericVariable>
        <org.jenkinsci.plugins.gwt.GenericVariable>
          <expressionType>JSONPath</expressionType>
          <key>PR_ACTION</key>
          <value>$.action</value>
          <regexpFilter></regexpFilter>
          <defaultValue></defaultValue>
        </org.jenkinsci.plugins.gwt.GenericVariable>
      </genericVariables>
      <!-- Substituted by jenkins/jobs/create-jobs.sh from git-webhook-secret's
           pr-token key at apply time - never a literal here, so repo read access
           alone can't invoke this endpoint (see jenkins/webhook-relay.yaml). -->
      <token>__PR_WEBHOOK_TOKEN__</token>
      <printContributedVariables>true</printContributedVariables>
      <printPostContent>false</printPostContent>
      <silentResponse>false</silentResponse>
      <regexpFilterText>$PR_ACTION</regexpFilterText>
      <regexpFilterExpression>^(opened|synchronize|reopened)$</regexpFilterExpression>
      <causeString>Triggered by GitHub pull_request ($PR_ACTION) on PR #$PR_NUMBER</causeString>
    </org.jenkinsci.plugins.gwt.GenericTrigger>
  </triggers>
  <disabled>false</disabled>
</flow-definition>
