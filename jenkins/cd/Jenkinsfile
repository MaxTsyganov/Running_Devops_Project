// CD pipeline: deploys an image that CI already built and pushed. Never
// rebuilds an image, never touches application source. Runs on the
// "cd-agent" Kubernetes pod template (jenkins/values.yaml, kubectl+helm), as
// cd-deploy-sa - RBAC scoped to exactly the devops-app namespace and the
// resource types Helm needs to touch, nothing broader (jenkins/rbac/cd-deploy-rbac.yaml).
@Library('devops-shared-lib') _
pipeline {
    agent {
        kubernetes {
            // inheritFrom, not label - see jenkins/ci/Jenkinsfile for why.
            // cloud is explicit too, for the same reason (two clouds exist).
            cloud 'devops-agents'
            inheritFrom 'cd-agent'
        }
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Immutable tag built by ci-application - never "latest"')
        // KEY=value manifest (release-manifest.txt) ci-Jenkinsfile always
        // supplies when it triggers this job - tag, CI build number, commit,
        // and all three service digests. `text`, not `string`: needs
        // multi-line values, which Jenkins' plain string parameter can't hold.
        text(name: 'RELEASE_MANIFEST', defaultValue: '', description: 'release-manifest.txt from the ci-application build that produced IMAGE_TAG. Required for a manual Build Now too - copy it from that build\'s archived artifact.')
    }

    options {
        timestamps()
        timeout(time: 25, unit: 'MINUTES') // Deploy alone can take up to 10m now
        disableConcurrentBuilds() // never two deploys to devops-app running at once
    }

    environment {
        ECR_REGISTRY     = '957905603240.dkr.ecr.us-east-1.amazonaws.com'
        TARGET_NAMESPACE = 'devops-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Input Validation') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error("IMAGE_TAG is required - this pipeline only deploys an image CI already built, it never builds one itself.")
                    }
                    if (params.IMAGE_TAG == 'latest') {
                        error("IMAGE_TAG must be an immutable tag (commit SHA), not 'latest'.")
                    }
                    if (!params.RELEASE_MANIFEST?.trim()) {
                        error("RELEASE_MANIFEST is required - it carries the per-service image digests CI produced, which is how a CD build satisfies Traceability back to the CI build, the commit, and the digest. ci-Jenkinsfile always supplies this when it triggers cd-application; a manual Build Now needs to copy it from that CI build's archived release-manifest.txt artifact.")
                    }
                    // Written to a file, not interpolated into the shell
                    // heredoc below - keeps the validation step below a plain
                    // file read with no shell-quoting surface, even though
                    // this content is CI's own output, not attacker-controlled.
                    writeFile file: 'release-manifest.txt', text: params.RELEASE_MANIFEST
                }
                container('deploy') {
                    sh '''
                        set -e
                        # Confirms the manifest was actually produced for *this*
                        # IMAGE_TAG (catches a stale/mismatched manifest on a manual
                        # trigger) and that all three digests are well-formed. This
                        # is deliberately format validation, not a live registry
                        # existence check: cd-deploy-sa is intentionally non-IRSA
                        # (jenkins/rbac/cd-deploy-rbac.yaml - it only ever calls the
                        # in-cluster Kubernetes API), and the assignment's own CD
                        # RBAC requirement is "only the namespace/resource types
                        # deployment needs" - granting AWS/ECR read access here to
                        # perform a live check would cut against that. A genuinely
                        # nonexistent image still fails safely regardless: kubelet's
                        # ImagePullBackOff surfaces in the Rollout stage below,
                        # which already triggers the same automated rollback path
                        # as any other post-deploy failure.
                        MANIFEST_TAG=$(grep '^IMAGE_TAG=' release-manifest.txt | cut -d= -f2)
                        if [ "$MANIFEST_TAG" != "${IMAGE_TAG}" ]; then
                            echo "RELEASE_MANIFEST is for tag '$MANIFEST_TAG', not the requested IMAGE_TAG '${IMAGE_TAG}' - refusing to deploy a mismatched manifest."
                            exit 1
                        fi
                        for svc in FRONTEND BACKEND WORKER; do
                            DIGEST=$(grep "^DIGEST_${svc}=" release-manifest.txt | cut -d= -f2)
                            echo "${svc} digest: ${DIGEST:-<missing>}"
                            echo "$DIGEST" | grep -qE '^sha256:[0-9a-f]{64}$' \
                                || { echo "DIGEST_${svc} in the manifest is missing or malformed (expected sha256:<64 hex chars>)."; exit 1; }
                        done
                        echo "Release manifest validated: tag ${IMAGE_TAG}, all three service digests well-formed."
                    '''
                }
                // Traceability: who triggered this, which image, where it's
                // going, and now which CI build/commit/digests produced it -
                // all straight from the validated manifest above, not just
                // inferred from the tag.
                echo "=== Deployment request ==="
                echo "Triggered by:     ${currentBuild.getBuildCauses()}"
                echo "Image tag:        ${params.IMAGE_TAG}"
                echo "Target namespace: ${env.TARGET_NAMESPACE}"
                echo "Target cluster:   devops-cluster (in-cluster deploy via cd-deploy-sa ServiceAccount)"
                echo "Release manifest:"
                echo params.RELEASE_MANIFEST
            }
        }

        stage('Load infra config') {
            steps {
                // Non-secret infra values (RDS host, S3 bucket, SNS topic,
                // the Secrets Manager secret NAME) change every terraform
                // apply, so they come from a ConfigMap instead of being
                // hardcoded here.
                container('deploy') {
                    script {
                        env.DB_HOST        = sh(script: "kubectl get configmap terraform-outputs -n ${env.TARGET_NAMESPACE} -o jsonpath='{.data.dbHost}'", returnStdout: true).trim()
                        env.S3_BUCKET      = sh(script: "kubectl get configmap terraform-outputs -n ${env.TARGET_NAMESPACE} -o jsonpath='{.data.s3BucketName}'", returnStdout: true).trim()
                        env.SNS_TOPIC      = sh(script: "kubectl get configmap terraform-outputs -n ${env.TARGET_NAMESPACE} -o jsonpath='{.data.snsTopicArn}'", returnStdout: true).trim()
                        env.DB_SECRET_NAME = sh(script: "kubectl get configmap terraform-outputs -n ${env.TARGET_NAMESPACE} -o jsonpath='{.data.dbPasswordSecretName}'", returnStdout: true).trim()
                    }
                }
            }
        }

        stage('Manifest Validation') {
            steps {
                container('deploy') {
                    sh '''
                        set -e
                        helm lint helm/devops-app --strict
                        helm template devops-app ./helm/devops-app \
                            --namespace ${TARGET_NAMESPACE} \
                            --set image.registry=${ECR_REGISTRY} \
                            --set image.tag=${IMAGE_TAG} \
                            --set config.dbHost=${DB_HOST} \
                            --set config.s3BucketName=${S3_BUCKET} \
                            --set config.snsTopicArn=${SNS_TOPIC} \
                            --set config.releaseVersion=${IMAGE_TAG} \
                            --set secrets.dbPasswordSecretName=${DB_SECRET_NAME} \
                            > /dev/null
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                container('deploy') {
                    script {
                        // Set before invoking Helm, not after it returns -
                        // read by post{failure{}} below to decide whether to
                        // even look for a rollback target. If `--wait`
                        // below times out, `helm upgrade --install` has
                        // already created the new revision server-side
                        // before its own CLI process exits non-zero; setting
                        // this only on success would miss exactly that case
                        // and report "nothing applied" while a bad revision
                        // sits live on the cluster. Checkout/Validation/
                        // Manifest-Validation failures never reach this
                        // stage, so the flag correctly stays unset for those.
                        env.HELM_DEPLOY_ATTEMPTED = 'true'
                    }
                    sh '''
                        set -e
                        # No --create-namespace: that makes Helm touch the
                        # Namespace object itself, which is cluster-scoped -
                        # no namespace-scoped Role can grant that without
                        # widening cd-deploy-sa to a ClusterRole. devops-app
                        # already exists from infra bring-up; CD deploys the
                        # app into it, it doesn't own namespace lifecycle.
                        # 10m, not 5m: --wait also blocks on frontend-service
                        # (type LoadBalancer) getting a hostname assigned, and
                        # a brand-new AWS load balancer's first provision
                        # routinely takes longer than 5 minutes on its own,
                        # even with every pod already healthy.
                        helm upgrade --install devops-app ./helm/devops-app \
                            --namespace ${TARGET_NAMESPACE} \
                            --set image.registry=${ECR_REGISTRY} \
                            --set image.tag=${IMAGE_TAG} \
                            --set config.dbHost=${DB_HOST} \
                            --set config.s3BucketName=${S3_BUCKET} \
                            --set config.snsTopicArn=${SNS_TOPIC} \
                            --set config.releaseVersion=${IMAGE_TAG} \
                            --set secrets.dbPasswordSecretName=${DB_SECRET_NAME} \
                            --wait --timeout 10m
                    '''
                }
            }
        }

        stage('Rollout') {
            steps {
                container('deploy') {
                    sh '''
                        set -e
                        kubectl rollout status deployment/frontend-deployment -n ${TARGET_NAMESPACE} --timeout=180s
                        kubectl rollout status deployment/backend-deployment -n ${TARGET_NAMESPACE} --timeout=180s
                        kubectl rollout status deployment/worker-deployment -n ${TARGET_NAMESPACE} --timeout=180s
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                container('deploy') {
                    sh '''
                        set -e
                        echo "=== Pods ==="
                        kubectl get pods -n ${TARGET_NAMESPACE} -o wide
                        echo "=== Services ==="
                        kubectl get services -n ${TARGET_NAMESPACE}
                        echo "=== Running image versions ==="
                        kubectl get pods -n ${TARGET_NAMESPACE} -o custom-columns='NAME:.metadata.name,IMAGE:.spec.containers[0].image'

                        # Excludes pods with a deletionTimestamp set (Terminating). With
                        # maxSurge=0/maxUnavailable=1, the old ReplicaSet's replica count
                        # drops as soon as a pod is marked for deletion, but the pod stays
                        # visible in `kubectl get pods` (status.phase still "Running") until
                        # its terminationGracePeriodSeconds elapses. Without this filter,
                        # Verify can catch that pod mid-exit and report a false "wrong
                        # version" failure - the rollout is actually done.
                        WRONG_VERSION=$(kubectl get pods -n ${TARGET_NAMESPACE} \
                            -o custom-columns='IMAGE:.spec.containers[0].image,DELETING:.metadata.deletionTimestamp' --no-headers \
                            | awk '$2 == "<none>" {print $1}' \
                            | grep -v ":${IMAGE_TAG}$" || true)
                        if [ -n "$WRONG_VERSION" ]; then
                            echo "Pod(s) running an unexpected image tag (expected :${IMAGE_TAG}):"
                            echo "$WRONG_VERSION"
                            exit 1
                        fi
                        echo "Confirmed: every pod is running :${IMAGE_TAG}"
                    '''
                }
            }
        }

        stage('Smoke Test') {
            steps {
                container('deploy') {
                    sh '''
                        set -e
                        # In-cluster Service DNS, not the public ELB hostname - deliberately,
                        # for a NetworkPolicy reason, not a connectivity one: cd-agent's
                        # egress on port 80 (this smoke test is plain HTTP) can be scoped
                        # tightly to exactly `app: frontend` Pods in devops-app
                        # (jenkins/networkpolicies.yaml) only because this target resolves to
                        # a real Pod IP NetworkPolicy can match against. The public ELB's
                        # hostname resolves to AWS IPs outside the cluster that no podSelector
                        # can ever reference, which would force that port-80 rule wide open to
                        # 0.0.0.0/0 instead - unlike port 443 (GitHub/ECR/KMS/PyPI/smee.io),
                        # port 80 here has exactly one real destination, so there's no reason
                        # to accept that broader exposure. Still proves the actual thing a
                        # smoke test needs to prove: the newly-deployed code is up and serving
                        # real HTTP responses - Rollout/Verify already confirm the Pods
                        # themselves are Ready.
                        INTERNAL_HOST="frontend-service.${TARGET_NAMESPACE}.svc.cluster.local"
                        for i in $(seq 1 6); do
                            if wget -q -O- --timeout=5 "http://${INTERNAL_HOST}/" >/dev/null 2>&1; then
                                echo "Smoke test passed: frontend responded on http://${INTERNAL_HOST}/"
                                exit 0
                            fi
                            echo "Waiting for Service endpoints to propagate... ($i/6)"
                            sleep 5
                        done
                        echo "Smoke test FAILED: frontend never responded"
                        exit 1
                    '''
                }
            }
        }

        // Assignment 5. A failure here reaches the exact same post{failure{}}
        // rollback logic below as every earlier stage - HELM_DEPLOY_ATTEMPTED
        // is already true by this point, so nothing about the rollback
        // mechanism itself needed to change for this stage to exist.
        stage('Monitoring Gate') {
            steps {
                container('deploy') {
                    sh '''
                        set -e
                        # In-cluster Service DNS, same reasoning as Smoke
                        # Test's own INTERNAL_HOST above - resolves to a real
                        # Pod IP jenkins-agent-policy's egress rule can match
                        # against (jenkins/networkpolicies.yaml, port 9090
                        # added alongside the existing port-80 rule).
                        PROM_HOST="observability-prometheus.observability.svc.cluster.local:9090"

                        # wget --post-data, not a GET query string: PromQL
                        # itself is full of characters (spaces, {}, ", |, ~)
                        # that would need careful percent-encoding in a URL -
                        # sending it as a form-encoded POST body sidesteps
                        # that entirely, since neither query below contains a
                        # literal "&" (the one character that actually needs
                        # escaping in a form body).
                        prom_query() {
                            wget -q -O- --timeout=10 --post-data="query=$1" "http://${PROM_HOST}/api/v1/query" 2>/dev/null || echo ""
                        }

                        echo "=== Waiting for Prometheus to confirm all three scrape targets are up ==="
                        # Not an immediate query: the freshly-rolled-out Pods'
                        # first scrape may not have happened yet
                        # (observability/values.yaml: scrapeInterval 30s) -
                        # a bounded retry here, same style as Smoke Test's own
                        # loop, not a blind sleep or a single query that could
                        # misreport a healthy deploy as down.
                        TARGETS_UP=""
                        for i in $(seq 1 12); do
                            RESPONSE=$(prom_query 'min(up{job=~"backend-service|worker-service|frontend-metrics-service"})')
                            if echo "$RESPONSE" | grep -q '"value":.*,"1"'; then
                                echo "All scrape targets confirmed up."
                                TARGETS_UP="true"
                                break
                            fi
                            echo "Waiting for scrape targets to report up... ($i/12)"
                            sleep 10
                        done
                        if [ "$TARGETS_UP" != "true" ]; then
                            echo "Monitoring Gate FAILED: scrape targets never reported up within the observation window"
                            exit 1
                        fi

                        # Smoke Test above exits on its first successful
                        # request - one real HTTP request total in the normal
                        # case, and even that one hits "/" - the static
                        # frontend root, served by nginx directly
                        # (frontend/nginx.k8s.conf's `location /`), which
                        # never reaches the backend at all. The error-rate
                        # check below reads http_requests_total{job="backend-
                        # service"}, so this deliberately hits GET
                        # /api/items instead - proxied to the backend
                        # (`location /api/`), read-only. Not /api/health:
                        # that path is in backend/app.py's own
                        # _METRICS_EXCLUDED_PATHS (health-check noise is
                        # deliberately kept out of http_requests_total), so
                        # hitting it here would generate zero traffic this
                        # query could ever see.
                        echo "=== Generating backend traffic for the error-rate check ==="
                        # 40 requests over ~40s, deliberately longer than one
                        # scrape interval (observability/values.yaml: 30s) -
                        # not just "some traffic", but traffic that spans at
                        # least one real scrape, so increase() below sees an
                        # actual counter delta instead of racing a window
                        # where nothing was sampled yet.
                        INTERNAL_HOST="frontend-service.${TARGET_NAMESPACE}.svc.cluster.local"
                        for i in $(seq 1 40); do
                            wget -q -O- --timeout=5 "http://${INTERNAL_HOST}/api/items" >/dev/null 2>&1 || true
                            sleep 1
                        done

                        echo "=== Checking backend error rate over the traffic window just generated ==="
                        # (sum(...) or vector(0)) around the 5xx numerator -
                        # not optional. Caught live: when zero requests
                        # actually returned a 5xx (the healthy case this
                        # gate exists to confirm), the label filter
                        # status=~"5.." matches no time series at all, and
                        # PromQL's sum()/increase() over zero matched series
                        # produces an EMPTY vector, not a literal 0 - so the
                        # division below yields empty too (no result for a
                        # missing numerator to divide), which the "no data"
                        # check above would then wrongly fail the gate on a
                        # perfectly healthy deploy. vector(0) supplies a real
                        # zero to divide by instead. Same fix applied to
                        # job:http_availability:ratio_rate5m in
                        # observability/rules/slo-recording-rules.yaml,
                        # which had the identical flaw.
                        # Bounded retry here too, not a single query - caught
                        # live on this exact deploy: increase() needs at
                        # least two scraped samples within its window to
                        # compute a delta, and a brand-new Pod's
                        # http_requests_total series doesn't exist at all
                        # until the first request with each exact label
                        # combination lands (prometheus_client only creates
                        # a labeled Counter series on first use, not at
                        # startup) - so a query fired the instant the
                        # traffic loop above ends can still race ahead of
                        # the second scrape that would let increase()
                        # produce a real value, even though the traffic
                        # itself already succeeded.
                        RESPONSE=""
                        for i in $(seq 1 6); do
                            RESPONSE=$(prom_query '(sum(increase(http_requests_total{job="backend-service",status=~"5.."}[2m])) or vector(0)) / sum(increase(http_requests_total{job="backend-service"}[2m]))')
                            # An empty result vector has no "value" key
                            # anywhere in the response at all - checked
                            # explicitly. Skipping this check is a real
                            # trap: with no "value" key, the "last ,\"...\"
                            # substring" extraction below would instead grab
                            # the JSON key name "result" (from an empty
                            # "result":[]), and awk's non-numeric-string-to-0
                            # coercion would then read that as "0% errors" -
                            # silently passing the gate on missing data
                            # instead of failing it. Caught live before this
                            # ever ran in a real build, not assumed safe.
                            if echo "$RESPONSE" | grep -q '"value":'; then
                                break
                            fi
                            echo "Waiting for the error-rate query to have real data... ($i/6)"
                            sleep 10
                        done
                        if ! echo "$RESPONSE" | grep -q '"value":'; then
                            echo "Monitoring Gate FAILED: error-rate query returned no data"
                            exit 1
                        fi
                        # Last ,"..." substring in the response, not a
                        # bracket-anchored pattern - avoids relying on how
                        # this shell's grep handles escaped [ ] (BRE
                        # semantics for that differ enough across
                        # implementations - GNU vs. BusyBox - that this is
                        # worth sidestepping rather than assuming). Safe now
                        # that the check above guarantees a "value" pair
                        # actually exists - it's always the last quoted
                        # string Prometheus emits for a single-result query.
                        ERROR_VALUE=$(echo "$RESPONSE" | grep -o ',"[^"]*"' | tail -1 | tr -d ',"')
                        echo "Backend error rate over the traffic window: ${ERROR_VALUE}"
                        # Same 5% threshold as the HighErrorRate alert
                        # (observability/rules/application-alerts.yaml) - a
                        # release CD would let through shouldn't already be
                        # sitting a hair away from paging someone. NaN (e.g.
                        # a 0/0 from zero traffic reaching the backend at
                        # all) fails the comparison too, correctly treated
                        # as "no meaningful data" rather than "0% errors".
                        awk -v v="$ERROR_VALUE" 'BEGIN { exit !(v+0 <= 0.05) }' || {
                            echo "Monitoring Gate FAILED: backend error rate ${ERROR_VALUE} exceeds the 5% threshold"
                            exit 1
                        }
                        echo "Monitoring Gate passed: backend error rate ${ERROR_VALUE} within threshold."
                    '''
                }
            }
        }
    }

    post {
        failure {
            script {
                if (env.HELM_DEPLOY_ATTEMPTED == 'true') {
                    echo "=== DEPLOYMENT FAILED after Deploy was attempted - checking actual cluster state for a rollback target ==="
                    container('deploy') {
                        sh '''
                            set -e
                            # Checked against the cluster's own recorded state, not a
                            # Groovy flag: this must equally cover (a) helm upgrade
                            # --install succeeding but a later Rollout/Verify/Smoke-Test
                            # stage failing, and (b) --wait itself timing out, where Helm
                            # already created the revision server-side before its own CLI
                            # process exited non-zero - a bare "did the sh step return 0"
                            # check would misreport case (b) as nothing having been applied.
                            if ! helm status devops-app -n ${TARGET_NAMESPACE} >/dev/null 2>&1; then
                                echo "No devops-app Helm release exists on the cluster - Deploy never actually created one. Nothing to roll back."
                            else
                                # `helm rollback` errors ("release has no 0 version") on a
                                # first-ever deploy - revision 1 has nothing earlier to roll
                                # back to. Caught live on this project's actual first deploy,
                                # not hypothesized: a bare `helm rollback` there crashed this
                                # whole post{failure{}} block with a raw Helm error instead of
                                # the informative message below. `helm history` always prints
                                # one header line plus one line per revision, so 2 lines total
                                # means exactly one revision exists.
                                REVISION_LINES=$(helm history devops-app -n ${TARGET_NAMESPACE} 2>/dev/null | wc -l)
                                if [ "$REVISION_LINES" -le 2 ]; then
                                    echo "This was the first-ever deploy (revision 1) - no earlier revision exists to roll back to. devops-app stays as deployed; fix forward with a new commit."
                                else
                                    helm rollback devops-app -n ${TARGET_NAMESPACE} --wait --timeout 5m
                                    echo "=== Rolled back. Pods now: ==="
                                    kubectl get pods -n ${TARGET_NAMESPACE} -o custom-columns='NAME:.metadata.name,IMAGE:.spec.containers[0].image'
                                fi
                            fi
                        '''
                    }
                } else {
                    echo """
=== DEPLOYMENT FAILED before Deploy was ever attempted ===
Nothing to roll back - devops-app is unchanged. Investigate:
  kubectl get pods -n ${env.TARGET_NAMESPACE}
  kubectl describe pod <pod-name> -n ${env.TARGET_NAMESPACE}
  kubectl get events -n ${env.TARGET_NAMESPACE} --sort-by=.metadata.creationTimestamp
"""
                }
            }
            script {
                def detail = (env.HELM_DEPLOY_ATTEMPTED == 'true') ? 'see build log for rollback outcome' : 'no revision was ever applied'
                container('deploy') {
                    notifySlack('FAILURE', "CD failed deploying :${params.IMAGE_TAG} to ${env.TARGET_NAMESPACE} - ${detail}.")
                }
            }
        }
        success {
            container('deploy') {
                notifySlack('SUCCESS', "Deployed :${params.IMAGE_TAG} to ${env.TARGET_NAMESPACE} - rollout, verify, and smoke test all passed.")
            }
        }
        always {
            cleanWs()
        }
    }
}
