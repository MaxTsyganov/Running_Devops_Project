// CD pipeline: deploys an image CI already built and pushed - never rebuilds or
// touches source. Runs as cd-deploy-sa on the "cd-agent" pod template
// (jenkins/values.yaml), RBAC-scoped to devops-app only (jenkins/rbac/cd-deploy-rbac.yaml).
@Library('devops-shared-lib') _
pipeline {
    agent {
        kubernetes {
            // inheritFrom, not label - see jenkins/ci/Jenkinsfile for why.
            // cloud is explicit too, for the same reason (two clouds exist).
            cloud 'devops-agents'
            inheritFrom 'cd-agent'
        }
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Immutable tag built by ci-application - never "latest"')
        // KEY=value manifest ci-Jenkinsfile supplies when triggering this job (tag,
        // build number, commit, all three digests). `text`, not `string`: needs multi-line values.
        text(name: 'RELEASE_MANIFEST', defaultValue: '', description: 'release-manifest.txt from the ci-application build that produced IMAGE_TAG. Required for a manual Build Now too - copy it from that build\'s archived artifact.')
    }

    options {
        timestamps()
        timeout(time: 25, unit: 'MINUTES') // Deploy alone can take up to 10m now
        disableConcurrentBuilds() // never two deploys to devops-app running at once
    }

    environment {
        ECR_REGISTRY     = '957905603240.dkr.ecr.us-east-1.amazonaws.com'
        TARGET_NAMESPACE = 'devops-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Input Validation') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error("IMAGE_TAG is required - this pipeline only deploys an image CI already built, it never builds one itself.")
                    }
                    if (params.IMAGE_TAG == 'latest') {
                        error("IMAGE_TAG must be an immutable tag (commit SHA), not 'latest'.")
                    }
                    if (!params.RELEASE_MANIFEST?.trim()) {
                        error("RELEASE_MANIFEST is required - it carries the per-service image digests CI produced, which is how a CD build satisfies Traceability back to the CI build, the commit, and the digest. ci-Jenkinsfile always supplies this when it triggers cd-application; a manual Build Now needs to copy it from that CI build's archived release-manifest.txt artifact.")
                    }
                    // Written to a file rather than interpolated into the shell below,
                    // so validation is a plain file read with no shell-quoting surface.
                    writeFile file: 'release-manifest.txt', text: params.RELEASE_MANIFEST
                }
                container('deploy') {
                    sh '''
                        set -e
                        # Confirms the manifest matches this IMAGE_TAG and all three digests
                        # are well-formed. Format validation only, not a live registry check -
                        # cd-deploy-sa is intentionally non-IRSA (jenkins/rbac/cd-deploy-rbac.yaml),
                        # and a genuinely missing image still fails safely via ImagePullBackOff
                        # in the Rollout stage below.
                        MANIFEST_TAG=$(grep '^IMAGE_TAG=' release-manifest.txt | cut -d= -f2)
                        if [ "$MANIFEST_TAG" != "${IMAGE_TAG}" ]; then
                            echo "RELEASE_MANIFEST is for tag '$MANIFEST_TAG', not the requested IMAGE_TAG '${IMAGE_TAG}' - refusing to deploy a mismatched manifest."
                            exit 1
                        fi
                        for svc in FRONTEND BACKEND WORKER; do
                            DIGEST=$(grep "^DIGEST_${svc}=" release-manifest.txt | cut -d= -f2)
                            echo "${svc} digest: ${DIGEST:-<missing>}"
                            echo "$DIGEST" | grep -qE '^sha256:[0-9a-f]{64}$' \
                                || { echo "DIGEST_${svc} in the manifest is missing or malformed (expected sha256:<64 hex chars>)."; exit 1; }
                        done
                        echo "Release manifest validated: tag ${IMAGE_TAG}, all three service digests well-formed."
                    '''
                }
                // Traceability: trigger, image, target, and the CI build/commit/digests
                // that produced it, straight from the validated manifest above.
                echo "=== Deployment request ==="
                echo "Triggered by:     ${currentBuild.getBuildCauses()}"
                echo "Image tag:        ${params.IMAGE_TAG}"
                echo "Target namespace: ${env.TARGET_NAMESPACE}"
                echo "Target cluster:   devops-cluster (in-cluster deploy via cd-deploy-sa ServiceAccount)"
                echo "Release manifest:"
                echo params.RELEASE_MANIFEST
            }
        }

        stage('Load infra config') {
            steps {
                // Non-secret infra values change on every terraform apply, so they
                // come from a ConfigMap instead of being hardcoded here.
                container('deploy') {
                    script {
                        env.DB_HOST        = sh(script: "kubectl get configmap terraform-outputs -n ${env.TARGET_NAMESPACE} -o jsonpath='{.data.dbHost}'", returnStdout: true).trim()
                        env.S3_BUCKET      = sh(script: "kubectl get configmap terraform-outputs -n ${env.TARGET_NAMESPACE} -o jsonpath='{.data.s3BucketName}'", returnStdout: true).trim()
                        env.SNS_TOPIC      = sh(script: "kubectl get configmap terraform-outputs -n ${env.TARGET_NAMESPACE} -o jsonpath='{.data.snsTopicArn}'", returnStdout: true).trim()
                        env.DB_SECRET_NAME = sh(script: "kubectl get configmap terraform-outputs -n ${env.TARGET_NAMESPACE} -o jsonpath='{.data.dbPasswordSecretName}'", returnStdout: true).trim()
                    }
                }
            }
        }

        stage('Manifest Validation') {
            steps {
                container('deploy') {
                    sh '''
                        set -e
                        helm lint helm/devops-app --strict
                        helm template devops-app ./helm/devops-app \
                            --namespace ${TARGET_NAMESPACE} \
                            --set image.registry=${ECR_REGISTRY} \
                            --set image.tag=${IMAGE_TAG} \
                            --set config.dbHost=${DB_HOST} \
                            --set config.s3BucketName=${S3_BUCKET} \
                            --set config.snsTopicArn=${SNS_TOPIC} \
                            --set config.releaseVersion=${IMAGE_TAG} \
                            --set secrets.dbPasswordSecretName=${DB_SECRET_NAME} \
                            > /dev/null
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                container('deploy') {
                    script {
                        // Set before invoking Helm, not after: post{failure{}} below uses this
                        // to decide whether to look for a rollback target. If --wait times out,
                        // Helm has already created the revision server-side, so setting this only
                        // on success would miss that case and report "nothing applied" on a live
                        // bad revision.
                        env.HELM_DEPLOY_ATTEMPTED = 'true'
                    }
                    sh '''
                        set -e
                        # No --create-namespace: that's cluster-scoped and would require
                        # widening cd-deploy-sa beyond its namespace Role. devops-app already
                        # exists from infra bring-up.
                        # 10m timeout: --wait also blocks on the LoadBalancer Service getting a
                        # hostname, which routinely takes longer than 5m even when pods are healthy.
                        helm upgrade --install devops-app ./helm/devops-app \
                            --namespace ${TARGET_NAMESPACE} \
                            --set image.registry=${ECR_REGISTRY} \
                            --set image.tag=${IMAGE_TAG} \
                            --set config.dbHost=${DB_HOST} \
                            --set config.s3BucketName=${S3_BUCKET} \
                            --set config.snsTopicArn=${SNS_TOPIC} \
                            --set config.releaseVersion=${IMAGE_TAG} \
                            --set secrets.dbPasswordSecretName=${DB_SECRET_NAME} \
                            --wait --timeout 10m
                    '''
                }
            }
        }

        stage('Rollout') {
            steps {
                container('deploy') {
                    sh '''
                        set -e
                        kubectl rollout status deployment/frontend-deployment -n ${TARGET_NAMESPACE} --timeout=180s
                        kubectl rollout status deployment/backend-deployment -n ${TARGET_NAMESPACE} --timeout=180s
                        kubectl rollout status deployment/worker-deployment -n ${TARGET_NAMESPACE} --timeout=180s
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                container('deploy') {
                    sh '''
                        set -e
                        echo "=== Pods ==="
                        kubectl get pods -n ${TARGET_NAMESPACE} -o wide
                        echo "=== Services ==="
                        kubectl get services -n ${TARGET_NAMESPACE}
                        echo "=== Running image versions ==="
                        kubectl get pods -n ${TARGET_NAMESPACE} -o custom-columns='NAME:.metadata.name,IMAGE:.spec.containers[0].image'

                        # Excludes Terminating pods (deletionTimestamp set): with maxSurge=0/
                        # maxUnavailable=1 they can still show "Running" until their grace
                        # period elapses, which would otherwise cause a false "wrong version"
                        # failure.
                        WRONG_VERSION=$(kubectl get pods -n ${TARGET_NAMESPACE} \
                            -o custom-columns='IMAGE:.spec.containers[0].image,DELETING:.metadata.deletionTimestamp' --no-headers \
                            | awk '$2 == "<none>" {print $1}' \
                            | grep -v ":${IMAGE_TAG}$" || true)
                        if [ -n "$WRONG_VERSION" ]; then
                            echo "Pod(s) running an unexpected image tag (expected :${IMAGE_TAG}):"
                            echo "$WRONG_VERSION"
                            exit 1
                        fi
                        echo "Confirmed: every pod is running :${IMAGE_TAG}"
                    '''
                }
            }
        }

        stage('Smoke Test') {
            steps {
                container('deploy') {
                    sh '''
                        set -e
                        # In-cluster Service DNS, not the public ELB hostname: this resolves to
                        # a real Pod IP that NetworkPolicy can scope egress to
                        # (jenkins/networkpolicies.yaml). The ELB hostname resolves to AWS IPs
                        # outside the cluster, which would force that port-80 rule open to
                        # 0.0.0.0/0 instead.
                        INTERNAL_HOST="frontend-service.${TARGET_NAMESPACE}.svc.cluster.local"
                        for i in $(seq 1 6); do
                            if wget -q -O- --timeout=5 "http://${INTERNAL_HOST}/" >/dev/null 2>&1; then
                                echo "Smoke test passed: frontend responded on http://${INTERNAL_HOST}/"
                                exit 0
                            fi
                            echo "Waiting for Service endpoints to propagate... ($i/6)"
                            sleep 5
                        done
                        echo "Smoke test FAILED: frontend never responded"
                        exit 1
                    '''
                }
            }
        }

        // Assignment 5. A failure here hits the same post{failure{}} rollback as any
        // earlier stage - HELM_DEPLOY_ATTEMPTED is already true by this point.
        stage('Monitoring Gate') {
            steps {
                container('deploy') {
                    sh '''
                        set -e
                        # In-cluster Service DNS again (same reasoning as Smoke Test's
                        # INTERNAL_HOST) - port 9090 added to jenkins-agent-policy's egress
                        # alongside port 80 (jenkins/networkpolicies.yaml).
                        PROM_HOST="observability-prometheus.observability.svc.cluster.local:9090"

                        # wget --post-data, not a GET query string: PromQL is full of
                        # characters that would need percent-encoding in a URL; neither query
                        # below contains "&", the one character that needs escaping in a form body.
                        prom_query() {
                            wget -q -O- --timeout=10 --post-data="query=$1" "http://${PROM_HOST}/api/v1/query" 2>/dev/null || echo ""
                        }

                        echo "=== Waiting for Prometheus to confirm all three scrape targets are up ==="
                        # Bounded retry, not a blind sleep or single query: freshly-rolled-out
                        # Pods' first scrape may not have happened yet (scrapeInterval 30s).
                        TARGETS_UP=""
                        for i in $(seq 1 12); do
                            RESPONSE=$(prom_query 'min(up{job=~"backend-service|worker-service|frontend-metrics-service"})')
                            if echo "$RESPONSE" | grep -q '"value":.*,"1"'; then
                                echo "All scrape targets confirmed up."
                                TARGETS_UP="true"
                                break
                            fi
                            echo "Waiting for scrape targets to report up... ($i/12)"
                            sleep 10
                        done
                        if [ "$TARGETS_UP" != "true" ]; then
                            echo "Monitoring Gate FAILED: scrape targets never reported up within the observation window"
                            echo "Runbook: https://github.com/MaxTsyganov/Running_Devops_Project/blob/main/observability/runbooks/prometheus-target-down.md"
                            echo "Rolling back - see post{failure{}} below."
                            exit 1
                        fi

                        # Smoke Test only hits "/" (static nginx root, never reaches the
                        # backend), but the error-rate check below reads backend metrics - so
                        # this hits GET /api/items instead. Not /api/health: that path is
                        # excluded from http_requests_total (backend/app.py's
                        # _METRICS_EXCLUDED_PATHS).
                        echo "=== Generating backend traffic for the error-rate check ==="
                        # 40 requests over ~40s - deliberately longer than one scrape interval
                        # (30s) so increase() below sees a real counter delta, not an empty window.
                        INTERNAL_HOST="frontend-service.${TARGET_NAMESPACE}.svc.cluster.local"
                        for i in $(seq 1 40); do
                            wget -q -O- --timeout=5 "http://${INTERNAL_HOST}/api/items" >/dev/null 2>&1 || true
                            sleep 1
                        done

                        echo "=== Checking backend error rate over the traffic window just generated ==="
                        # (sum(...) or vector(0)) around the 5xx numerator is required: with
                        # zero 5xx responses, the status=~"5.." filter matches no series and
                        # PromQL returns an empty vector (not 0), which would wrongly fail the
                        # "no data" check on a healthy deploy. Same fix applied in
                        # observability/rules/slo-recording-rules.yaml.
                        # Bounded retry here too: increase() needs two scraped samples to
                        # compute a delta, and a brand-new Pod's counter series doesn't exist
                        # until first use - a query fired right as the traffic loop ends can
                        # still race the next scrape.
                        RESPONSE=""
                        for i in $(seq 1 6); do
                            RESPONSE=$(prom_query '(sum(increase(http_requests_total{job="backend-service",status=~"5.."}[2m])) or vector(0)) / sum(increase(http_requests_total{job="backend-service"}[2m]))')
                            # An empty result vector has no "value" key at all. Skipping this
                            # check would let the substring extraction below grab the JSON key
                            # "result" instead, which awk would coerce to 0 - silently passing
                            # the gate on missing data.
                            if echo "$RESPONSE" | grep -q '"value":'; then
                                break
                            fi
                            echo "Waiting for the error-rate query to have real data... ($i/6)"
                            sleep 10
                        done
                        if ! echo "$RESPONSE" | grep -q '"value":'; then
                            echo "Monitoring Gate FAILED: error-rate query returned no data"
                            echo "Runbook: https://github.com/MaxTsyganov/Running_Devops_Project/blob/main/observability/runbooks/prometheus-target-down.md"
                            echo "Rolling back - see post{failure{}} below."
                            exit 1
                        fi
                        # Last ,"..." substring, not a bracket-anchored pattern - avoids
                        # relying on BRE semantics for [ ] that differ between grep
                        # implementations (GNU/BusyBox).
                        ERROR_VALUE=$(echo "$RESPONSE" | grep -o ',"[^"]*"' | tail -1 | tr -d ',"')
                        echo "Backend error rate over the traffic window: ${ERROR_VALUE}"
                        # Same 5% threshold as the HighErrorRate alert (observability/rules/
                        # application-alerts.yaml). NaN (e.g. 0/0 from zero traffic) fails the
                        # comparison too - treated as "no data" rather than "0% errors".
                        awk -v v="$ERROR_VALUE" 'BEGIN { exit !(v+0 <= 0.05) }' || {
                            echo "Monitoring Gate FAILED: backend error rate ${ERROR_VALUE} exceeds the 5% threshold"
                            echo "Runbook: https://github.com/MaxTsyganov/Running_Devops_Project/blob/main/observability/runbooks/high-error-rate.md"
                            echo "Rolling back - see post{failure{}} below."
                            exit 1
                        }
                        echo "Monitoring Gate passed: backend error rate ${ERROR_VALUE} within threshold."

                        # Second SLO check: the assignment requires the gate to check both
                        # error rate and latency. Same bounded-retry pattern as above; no
                        # vector(0) fallback needed since the duration histogram always has
                        # series once any traffic exists.
                        echo "=== Checking backend p95 latency over the traffic window ==="
                        LATENCY_RESPONSE=""
                        for i in $(seq 1 6); do
                            LATENCY_RESPONSE=$(prom_query 'histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job="backend-service"}[2m])) by (le))')
                            # Checked for NaN too, not just a missing "value" key: with too few
                            # samples histogram_quantile returns "NaN" as its value, which awk
                            # would coerce to 0s - silently passing the gate on the same "no data"
                            # condition.
                            if echo "$LATENCY_RESPONSE" | grep -q '"value":' && ! echo "$LATENCY_RESPONSE" | grep -q '"NaN"'; then
                                break
                            fi
                            echo "Waiting for the latency query to have real data... ($i/6)"
                            sleep 10
                        done
                        if ! echo "$LATENCY_RESPONSE" | grep -q '"value":' || echo "$LATENCY_RESPONSE" | grep -q '"NaN"'; then
                            echo "Monitoring Gate FAILED: latency query returned no data"
                            echo "Runbook: https://github.com/MaxTsyganov/Running_Devops_Project/blob/main/observability/runbooks/prometheus-target-down.md"
                            echo "Rolling back - see post{failure{}} below."
                            exit 1
                        fi
                        LATENCY_VALUE=$(echo "$LATENCY_RESPONSE" | grep -o ',"[^"]*"' | tail -1 | tr -d ',"')
                        echo "Backend p95 latency over the traffic window: ${LATENCY_VALUE}s"
                        # Same 1s threshold as the HighLatencyP95 alert (observability/rules/
                        # application-alerts.yaml) - same reasoning as the error-rate check above.
                        awk -v v="$LATENCY_VALUE" 'BEGIN { exit !(v+0 <= 1) }' || {
                            echo "Monitoring Gate FAILED: backend p95 latency ${LATENCY_VALUE}s exceeds the 1s threshold"
                            echo "Runbook: https://github.com/MaxTsyganov/Running_Devops_Project/blob/main/observability/runbooks/high-latency-p95.md"
                            echo "Rolling back - see post{failure{}} below."
                            exit 1
                        }
                        echo "Monitoring Gate passed: backend p95 latency ${LATENCY_VALUE}s within threshold."
                    '''
                }
            }
        }
    }

    post {
        failure {
            script {
                if (env.HELM_DEPLOY_ATTEMPTED == 'true') {
                    echo "=== DEPLOYMENT FAILED after Deploy was attempted - checking actual cluster state for a rollback target ==="
                    container('deploy') {
                        sh '''
                            set -e
                            # Checked against the cluster's recorded state, not a bare "did
                            # sh return 0": that would misreport a --wait timeout as nothing
                            # applied, even though Helm already created the revision server-side.
                            if ! helm status devops-app -n ${TARGET_NAMESPACE} >/dev/null 2>&1; then
                                echo "No devops-app Helm release exists on the cluster - Deploy never actually created one. Nothing to roll back."
                            else
                                # `helm rollback` errors on a first-ever deploy (revision 1 has
                                # nothing to roll back to) - crashed this whole block with a raw
                                # Helm error until this check was added. `helm history` prints a
                                # header plus one line per revision.
                                REVISION_LINES=$(helm history devops-app -n ${TARGET_NAMESPACE} 2>/dev/null | wc -l)
                                if [ "$REVISION_LINES" -le 2 ]; then
                                    echo "This was the first-ever deploy (revision 1) - no earlier revision exists to roll back to. devops-app stays as deployed; fix forward with a new commit."
                                else
                                    helm rollback devops-app -n ${TARGET_NAMESPACE} --wait --timeout 5m
                                    echo "=== Rolled back. Pods now: ==="
                                    kubectl get pods -n ${TARGET_NAMESPACE} -o custom-columns='NAME:.metadata.name,IMAGE:.spec.containers[0].image'
                                fi
                            fi
                        '''
                    }
                } else {
                    echo """
=== DEPLOYMENT FAILED before Deploy was ever attempted ===
Nothing to roll back - devops-app is unchanged. Investigate:
  kubectl get pods -n ${env.TARGET_NAMESPACE}
  kubectl describe pod <pod-name> -n ${env.TARGET_NAMESPACE}
  kubectl get events -n ${env.TARGET_NAMESPACE} --sort-by=.metadata.creationTimestamp
"""
                }
            }
            script {
                def detail = (env.HELM_DEPLOY_ATTEMPTED == 'true') ? 'see build log for rollback outcome' : 'no revision was ever applied'
                container('deploy') {
                    notifySlack('FAILURE', "CD failed deploying :${params.IMAGE_TAG} to ${env.TARGET_NAMESPACE} - ${detail}.")
                }
            }
        }
        success {
            container('deploy') {
                notifySlack('SUCCESS', "Deployed :${params.IMAGE_TAG} to ${env.TARGET_NAMESPACE} - rollout, verify, and smoke test all passed.")
            }
        }
        always {
            cleanWs()
        }
    }
}
