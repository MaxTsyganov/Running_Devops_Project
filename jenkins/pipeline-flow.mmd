%% Jenkins CI/CD + Observability architecture - Assignments 4-5 - Pipeline Flow View
%% Logical order of a single run: commit -> CI -> image build -> registry ->
%% CD -> rollout -> smoke test -> Monitoring Gate -> rollback. For where each
%% of these actually runs (clusters/namespaces/Pods/network boundaries), see
%% architecture.mmd.

sequenceDiagram
    actor Dev as Developer
    participant GH as GitHub repo
    participant Relay as webhook-relay Pod
    participant Ctrl as Jenkins controller
    participant PR as PR agent Pod
    participant CI as CI agent Pod
    participant ECR as ECR registry
    participant CD as CD agent Pod
    participant K8s as Kubernetes (devops-app)
    participant Prom as Prometheus (Assignment 5)
    participant Slack as Slack (bonus)
    actor User as End user

    rect rgb(255, 245, 225)
        note over PR: Bonus: PR quality gate (pr-Jenkinsfile) - separate job, separate trigger
        Dev->>GH: open/update a Pull Request
        GH->>Relay: webhook POST (pull_request event)
        Relay->>Ctrl: forward to /generic-webhook-trigger/ (different endpoint than push)
        Ctrl->>PR: spawn ephemeral agent Pod, run ci-application-pr
        PR->>PR: Checkout PR head, Lint, Tests, Build (no push), Scan (blocking)
        PR->>Ctrl: pass/fail shown on the PR's build page - never pushes an image, never triggers CD
    end

    Dev->>GH: git push (main)
    GH->>Relay: webhook POST (HMAC-signed)
    Relay->>Ctrl: forward to /github-webhook/ (internal only)
    Ctrl->>CI: spawn ephemeral agent Pod, run ci-application

    rect rgb(232, 245, 233)
        note over CI: CI Pipeline (ci-Jenkinsfile)
        CI->>CI: Checkout (branch, commit SHA, build #)
        CI->>CI: Validation (Dockerfiles, chart files present)
        CI->>CI: Observability Validation (Assignment 5: dashboard JSON, promtool check rules, kubeconform schema)
        CI->>CI: Static Analysis / Lint
        CI->>CI: Tests (unit tests, results published to Jenkins)
        alt tests fail
            CI--xCtrl: build marked failed
            note over Ctrl: no image pushed, CD never triggered
        else tests pass
            par matrix cell: frontend
                CI->>CI: Build (Kaniko, own Pod, no Docker socket, local tarball only - no push yet)
                CI->>CI: Scan (Trivy, blocks on fixable CRITICAL) + SBOM (CycloneDX) - against that local tarball
                CI->>ECR: Push (crane), tagged with immutable commit SHA - only after the scan passed
                ECR-->>CI: digest (crane's own reported digest, not predicted before the push)
                CI->>CI: Sign digest (Cosign, AWS KMS key)
                CI->>CI: Publish metadata (tag + digest, archived)
            and matrix cell: backend
                CI->>CI: same 5 steps, own Pod
            and matrix cell: worker
                CI->>CI: same 5 steps, own Pod
            end
            CI->>CI: assemble release-manifest.txt (tag, CI build #, commit, all 3 digests)
            CI->>Ctrl: build succeeded (any cell failing fails the whole build)
            Ctrl->>CD: trigger cd-application(IMAGE_TAG=<sha>, RELEASE_MANIFEST=...)
        end
        CI->>Slack: notifySlack() - bonus, success or failure either way
    end

    rect rgb(227, 242, 253)
        note over CD: CD Pipeline (cd-Jenkinsfile) - never rebuilds the image
        CD->>CD: Checkout (Helm chart only)
        CD->>CD: Input Validation (tag not latest, manifest matches tag, digests well-formed)
        CD->>CD: Manifest Validation (helm lint, helm template)
        CD->>K8s: Authenticate via cd-deploy-sa ServiceAccount
        CD->>K8s: helm upgrade --install (same tag CI just pushed)
        CD->>K8s: kubectl rollout status, per Deployment
        alt rollout fails or times out
            K8s--xCD: rollout incomplete
            CD--xCtrl: build marked failed, logs/events surfaced
            CD->>K8s: automated rollback: helm rollback devops-app (only if a revision was already live)
        else rollout succeeds
            CD->>K8s: Verify - every Pod running the expected tag
            CD->>K8s: Smoke test - real HTTP request to frontend-service (in-cluster DNS)
            alt smoke test fails
                CD--xCtrl: build marked failed
                CD->>K8s: automated rollback: helm rollback devops-app (only if a revision was already live)
            else smoke test passes
                note over CD,Prom: Monitoring Gate (Assignment 5)
                CD->>Prom: poll up==1 for all 3 services (bounded retry)
                CD->>K8s: generate real traffic - GET /api/items via frontend-service
                CD->>Prom: query backend error rate over that traffic window (bounded retry)
                alt targets never came up, or error rate exceeds 5%
                    CD--xCtrl: build marked failed
                    CD->>K8s: automated rollback: helm rollback devops-app (only if a revision was already live)
                else release is healthy
                    CD->>Ctrl: build succeeded
                end
            end
        end
        CD->>Slack: notifySlack() - bonus, success or failure either way
    end

    User->>K8s: normal traffic, once deployed
