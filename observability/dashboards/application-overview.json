{
  "title": "Application Overview",
  "uid": "application-overview",
  "tags": ["devops-app", "assignment-5"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "version",
        "type": "query",
        "label": "Release version",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(app_info, git_sha)", "refId": "version-variable" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Pod",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(kube_pod_info{namespace=\"devops-app\"}, pod)", "refId": "pod-variable" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by status (backend)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"backend-service\", git_sha=~\"$version\"}[5m])) by (status)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate (5xx / total)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - job:http_availability:ratio_rate5m"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency (p50 / p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "job:http_request_duration_seconds:p50_rate5m", "legendFormat": "p50" },
        { "refId": "B", "expr": "job:http_request_duration_seconds:p95_rate5m", "legendFormat": "p95" }
      ]
    },
    {
      "id": 4,
      "title": "Items created (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "rate(items_created_total{git_sha=~\"$version\"}[5m])" }
      ]
    },
    {
      "id": 5,
      "title": "Worker: items processed / poll errors (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "rate(worker_items_processed_total{git_sha=~\"$version\"}[5m])", "legendFormat": "processed" },
        { "refId": "B", "expr": "rate(worker_poll_errors_total{git_sha=~\"$version\"}[5m])", "legendFormat": "poll errors" }
      ]
    },
    {
      "id": 6,
      "title": "Worker: seconds since last successful poll",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "time() - worker_last_poll_timestamp_seconds{git_sha=~\"$version\"}" }
      ]
    },
    {
      "id": 7,
      "title": "Frontend: active nginx connections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "nginx_connections_active" }
      ]
    },
    {
      "id": 8,
      "title": "Running Pods by app (selected)",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "kube_pod_info{namespace=\"devops-app\", pod=~\"$pod\"}", "format": "table", "instant": true }
      ]
    }
  ]
}
