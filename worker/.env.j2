# =============================================================
#  Worker Service — Dynamic Environment Configuration
# =============================================================

# ── PostgreSQL / RDS ──────────────────────────────────────────
DB_HOST={{ db_host }}
DB_PORT=5432
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD={{ db_password }}

# ── AWS Region ────────────────────────────────────────────────
AWS_REGION={{ aws_region }}

# ── S3 ────────────────────────────────────────────────────────
S3_BUCKET_NAME={{ s3_bucket }}

# ── SNS ───────────────────────────────────────────────────────
SNS_TOPIC_ARN={{ sns_arn }}

# ── Worker Settings ───────────────────────────────────────────
POLL_INTERVAL_SECONDS=30

# ── AWS Credentials (Blank since EC2 Instance Profile is used) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=